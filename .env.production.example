# ==============================================================================
# Koroush Barber — Production Environment Configuration (.env.production)
# Target Domain: koroushbarber.ir
# Operating System: Ubuntu Server 24.04 LTS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Domain Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://koroushbarber.ir
DOMAIN=koroushbarber.ir

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16 in Isolated Docker Network)
# ------------------------------------------------------------------------------
DB_USER=koroush_user
# Use a strong, random password (auto-generated by deploy-ubuntu.sh):
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD
DB_NAME=koroush_barber
DB_PORT=5432

# Computed Connection String used by Next.js & Prisma inside container:
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public

# ------------------------------------------------------------------------------
# 3. Security & Authentication Secrets
# Generate using: openssl rand -base64 32
# ------------------------------------------------------------------------------
ADMIN_JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# ------------------------------------------------------------------------------
# 4. Initial Administrator Account (Only used on first deployment)
# If an owner already exists in the database, these are ignored to preserve data.
# ------------------------------------------------------------------------------
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_SECURE_ADMIN_PASSWORD
ADMIN_INITIAL_NAME=کوروش احمدی (مدیر ارشد سالن)

# ------------------------------------------------------------------------------
# 5. Payment Gateway Configuration (ZarinPal IPG)
# Default is MOCK for safe initial deployment without real banking gateway
# Options: MOCK | ZARINPAL
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY=MOCK
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# ------------------------------------------------------------------------------
# 6. SMS Provider Configuration (KaveNegar SMS API)
# Default is MOCK for safe initial deployment
# Options: MOCK | KAVENEGAR
# ------------------------------------------------------------------------------
SMS_PROVIDER=MOCK
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=verify
