# ==============================================================================
# Koroush Barber | آرایشگاه کوروش — Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Network
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
APP_TIMEZONE="Asia/Tehran"
# Canonical public URL (used for payment gateway redirects and metadata)
NEXT_PUBLIC_APP_URL="https://koroushbarber.ir"

# ------------------------------------------------------------------------------
# Database Connection (Prisma)
# ------------------------------------------------------------------------------
# Development (SQLite):
# DATABASE_URL="file:./dev.db"

# Production (PostgreSQL Docker / Managed Database):
DATABASE_URL="postgresql://koroush_user:StrongPasswordHere123!@localhost:5432/koroush_barber?schema=public"

# ------------------------------------------------------------------------------
# Security & Admin Session Authentication
# ------------------------------------------------------------------------------
# Cryptographic secret for signing Admin JWT session cookies (min 32 chars)
ADMIN_JWT_SECRET="replace-with-a-64-character-random-secret-generated-by-openssl-rand-hex-32"
NEXTAUTH_SECRET="replace-with-a-64-character-random-secret-generated-by-openssl-rand-hex-32"
NEXTAUTH_URL="https://koroushbarber.ir"

# ------------------------------------------------------------------------------
# Payment Gateway Provider Configuration
# ------------------------------------------------------------------------------
# Active provider: "MOCK" (for local sandbox & deterministic tests) or "ZARINPAL" (production)
PAYMENT_GATEWAY="MOCK"

# ZarinPal credentials (required if PAYMENT_GATEWAY=ZARINPAL)
# Format: 36-character UUID Merchant ID provided by ZarinPal panel
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
# Set to "true" for testing on sandbox.zarinpal.com, "false" for live production
ZARINPAL_SANDBOX="false"

# ------------------------------------------------------------------------------
# Iranian SMS & OTP Provider Configuration
# ------------------------------------------------------------------------------
# Active provider: "MOCK" (logs to stdout / in-memory for testing) or "KAVENEGAR" (production)
SMS_PROVIDER="MOCK"

# Kavenegar credentials (required if SMS_PROVIDER=KAVENEGAR)
KAVENEGAR_API_KEY="your-kavenegar-api-key-here"
# Dedicated line number for standard SMS (e.g., 1000..., 9000...)
KAVENEGAR_SENDER="10008663"
# OTP Fast-Delivery Lookup Template registered in Kavenegar console
KAVENEGAR_OTP_TEMPLATE="koroush-verify"
